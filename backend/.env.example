# GeoNetra Backend Environment Configuration Example
# Replace placeholder values with your actual API credentials

# Google Gemini API key for bilingual summary generation and social radar scanning
GEMINI_API_KEY=your_gemini_api_key_here

# Backend port (default: 3000)
PORT=3000

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/geonetra_db?retryWrites=true&w=majority

# JWT Token Secret
JWT_SECRET=geonetra-secure-jwt-key-2026-secret

