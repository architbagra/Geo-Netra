# GeoNetra Root Environment Configuration Template
# (Copy to backend/.env and replace placeholders with real values)

# Google Gemini API Key (Required for AI Summary generation & Social Media Radar)
GEMINI_API_KEY=your_gemini_api_key_here

# Backend Port (Default: 3000)
PORT=3000

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/geonetra_db?retryWrites=true&w=majority

# JWT Token Secret
JWT_SECRET=geonetra-secure-jwt-key-2026-secret

